@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .

<https://danja.github.io/flues/plugins/chatgen>
    a lv2:UtilityPlugin ;
    doap:name "ChatGen" ;
    doap:license <https://opensource.org/licenses/MIT> ;
    lv2:project <https://danja.github.io/flues> ;
    lv2:requiredFeature urid:map ;
    lv2:optionalFeature lv2:hardRTCapable ;
    ui:ui <https://danja.github.io/flues/plugins/chatgen#ui> ;

    rdfs:comment "Text to MIDI CC generator for Chatterbox speech synthesis" ;

    lv2:port [
        a atom:AtomPort, lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "control" ;
        lv2:name "Control" ;
        atom:bufferType atom:Sequence ;
        atom:supports <http://lv2plug.in/ns/ext/time#Position> ,
                     <http://lv2plug.in/ns/ext/midi#MidiEvent> ;
        rdfs:comment "Control input for time position and MIDI events from host" ;
    ] , [
        a atom:AtomPort, lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "midi_out" ;
        lv2:name "MIDI Output" ;
        atom:bufferType atom:Sequence ;
        atom:supports <http://lv2plug.in/ns/ext/midi#MidiEvent> ;
        rdfs:comment "MIDI CC messages for formant control (CC 71, 10, 74, 75)" ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 2 ;
        lv2:symbol "play" ;
        lv2:name "Play" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ;
        rdfs:comment "Start/stop MIDI output" ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 3 ;
        lv2:symbol "loop" ;
        lv2:name "Loop" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ;
        rdfs:comment "Loop phoneme sequence" ;
    ] , [
        a atom:AtomPort, lv2:OutputPort ;
        lv2:index 4 ;
        lv2:symbol "text_out" ;
        lv2:name "Text Output" ;
        atom:bufferType atom:Sequence ;
        atom:supports atom:String ;
        rdfs:comment "Current text echoed back to UI for persistence" ;
    ] .
