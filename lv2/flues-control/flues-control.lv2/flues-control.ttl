@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .

<https://danja.github.io/flues/plugins/flues-control>
    a lv2:UtilityPlugin ;
    doap:name "Flues Control" ;
    doap:license <https://opensource.org/licenses/MIT> ;
    lv2:project <https://danja.github.io/flues> ;
    lv2:requiredFeature urid:map ;
    lv2:optionalFeature lv2:hardRTCapable ;

    rdfs:comment "MIDI CC controller for flues-synth with 29 programs (0-28) and 9 parameter sliders" ;

    lv2:port [
        # Port 0: MIDI Input
        a atom:AtomPort, lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "midi_in" ;
        lv2:name "MIDI Input" ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        rdfs:comment "MIDI note messages pass through unchanged" ;
    ] , [
        # Port 1: MIDI Output
        a atom:AtomPort, lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "midi_out" ;
        lv2:name "MIDI Output" ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        rdfs:comment "MIDI Program Change and CC messages for flues-synth" ;
    ] , [
        # Port 2: Program Selector
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 2 ;
        lv2:symbol "program" ;
        lv2:name "Program" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 28 ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [
            rdfs:label "Disyn Echo" ;
            rdf:value 0
        ] , [
            rdfs:label "Disyn + Delays" ;
            rdf:value 1
        ] , [
            rdfs:label "Disyn + Filter" ;
            rdf:value 2
        ] , [
            rdfs:label "Formant Voice" ;
            rdf:value 3
        ] , [
            rdfs:label "Hybrid Speech" ;
            rdf:value 4
        ] , [
            rdfs:label "Physical Model" ;
            rdf:value 5
        ] , [
            rdfs:label "(Physical Model)" ;
            rdf:value 6
        ] , [
            rdfs:label "Disyn Direct" ;
            rdf:value 7
        ] , [
            rdfs:label "ModFM Formant" ;
            rdf:value 8
        ] , [
            rdfs:label "DSF Inharmonic" ;
            rdf:value 9
        ] , [
            rdfs:label "PAF Direct" ;
            rdf:value 10
        ] , [
            rdfs:label "Cascaded DSF+PAF" ;
            rdf:value 11
        ] , [
            rdfs:label "Tanh Spectral" ;
            rdf:value 12
        ] , [
            rdfs:label "Hybrid DSF→Formant" ;
            rdf:value 13
        ] , [
            rdfs:label "Feedback ModFM" ;
            rdf:value 14
        ] , [
            rdfs:label "Dirichlet Explorer" ;
            rdf:value 15
        ] , [
            rdfs:label "Multi-Algorithm" ;
            rdf:value 16
        ] , [
            rdfs:label "Spectral Sculptor" ;
            rdf:value 17
        ] , [
            rdfs:label "Hybrid Formant (Alg 7)" ;
            rdf:value 18
        ] , [
            rdfs:label "Cascaded (Alg 8)" ;
            rdf:value 19
        ] , [
            rdfs:label "Parallel Bank (Alg 9)" ;
            rdf:value 20
        ] , [
            rdfs:label "Feedback (Alg 10)" ;
            rdf:value 21
        ] , [
            rdfs:label "Morphing (Alg 11)" ;
            rdf:value 22
        ] , [
            rdfs:label "Inharmonic (Alg 12)" ;
            rdf:value 23
        ] , [
            rdfs:label "Adaptive Filter (Alg 13)" ;
            rdf:value 24
        ] , [
            rdfs:label "Multi-Stage (Alg 14)" ;
            rdf:value 25
        ] , [
            rdfs:label "Freq Asymmetry (Alg 15)" ;
            rdf:value 26
        ] , [
            rdfs:label "Cross-Mod (Alg 16)" ;
            rdf:value 27
        ] , [
            rdfs:label "Vocal Morph" ;
            rdf:value 28
        ] ;
        rdfs:comment "Synth program selector (remaps sliders to different parameters)" ;
    ] , [
        # Port 3: Slider 1 → CC 73
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 3 ;
        lv2:symbol "slider1" ;
        lv2:name "Slider 1 (CC 73)" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Program-dependent: Algorithm/Feedback/Filter Freq/F1 Jaw/etc." ;
    ] , [
        # Port 4: Slider 2 → CC 72
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "slider2" ;
        lv2:name "Slider 2 (CC 72)" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Program-dependent: Param1/Feedback/Filter Q/F2 Tongue/etc." ;
    ] , [
        # Port 5: Slider 3 → CC 28
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "slider3" ;
        lv2:name "Slider 3 (CC 28)" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Program-dependent: Param2/Filter Feedback/Filter Shape/F3 Lips/etc." ;
    ] , [
        # Port 6: Slider 4 → CC 30
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "slider4" ;
        lv2:name "Slider 4 (CC 30)" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Program-dependent: Interface Type/Disyn Level/F4 Quality/etc." ;
    ] , [
        # Port 7: Slider 5 → CC 74
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "slider5" ;
        lv2:name "Slider 5 (CC 74)" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Program-dependent: Intensity/Noise Level/Disyn Level/etc." ;
    ] , [
        # Port 8: Slider 6 → CC 71
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "slider6" ;
        lv2:name "Slider 6 (CC 71)" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Program-dependent: Tuning/Nasal/Master Gain/etc." ;
    ] , [
        # Port 9: Slider 7 → CC 1
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "slider7" ;
        lv2:name "Slider 7 (CC 1)" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Program-dependent: Delay Feedback/Ratio/Master Gain/etc." ;
    ] , [
        # Port 10: Slider 8 → CC 27 (Attack)
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "slider8" ;
        lv2:name "Attack (CC 27)" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Envelope attack time (1-1000ms exponential, fixed across all programs)" ;
    ] , [
        # Port 11: Slider 9 → CC 7 (Release)
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "slider9" ;
        lv2:name "Release (CC 7)" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Envelope release time (10-3000ms exponential, fixed across all programs)" ;
    ] .
