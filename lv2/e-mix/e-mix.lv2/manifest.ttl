@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .

<https://danja.github.io/flues/plugins/e-mix>
    a lv2:Plugin ;
    lv2:binary <e_mix.so> ;
    rdfs:seeAlso <e-mix.ttl> .

<https://danja.github.io/flues/plugins/e-mix#ui>
    a ui:X11UI ;
    ui:binary <e_mix_ui.so> ;
    rdfs:label "E-Mix" .
