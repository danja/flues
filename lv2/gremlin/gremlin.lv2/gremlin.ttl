<https://danja.github.io/flues/plugins/gremlin#ui>
    a ui:X11UI ;
    ui:binary <gremlin_ui.so> ;
    rdfs:label "Gremlin Control Panel" ;
    ui:portNotification [
        ui:plugin <https://danja.github.io/flues/plugins/gremlin> ;
        ui:port [ lv2:index 30 ; lv2:symbol "live_mode" ] ;
        ui:portIndex 30 ;
        ui:protocol ui:floatProtocol
    ] , [
        ui:plugin <https://danja.github.io/flues/plugins/gremlin> ;
        ui:port [ lv2:index 31 ; lv2:symbol "live_damage" ] ;
        ui:portIndex 31 ;
        ui:protocol ui:floatProtocol
    ] , [
        ui:plugin <https://danja.github.io/flues/plugins/gremlin> ;
        ui:port [ lv2:index 32 ; lv2:symbol "live_chaos" ] ;
        ui:portIndex 32 ;
        ui:protocol ui:floatProtocol
    ] , [
        ui:plugin <https://danja.github.io/flues/plugins/gremlin> ;
        ui:port [ lv2:index 33 ; lv2:symbol "live_noise" ] ;
        ui:portIndex 33 ;
        ui:protocol ui:floatProtocol
    ] , [
        ui:plugin <https://danja.github.io/flues/plugins/gremlin> ;
