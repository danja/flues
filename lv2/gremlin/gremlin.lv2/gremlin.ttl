        lv2:symbol "duck" ;
        lv2:name "Duck" ;
        lv2:default 0.10 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0
    ] , [
        a lv2:OutputPort , atom:AtomPort ;
        lv2:index 29 ;
        lv2:symbol "controller_out" ;
        lv2:name "Controller Out" ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 30 ;
        lv2:symbol "live_mode" ;
        lv2:name "Live Mode" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 3 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Shard" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Servo" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Spray" ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "Collapse" ; rdf:value 3 ]
    ] , [
