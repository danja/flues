@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .

<https://danja.github.io/flues/plugins/chordant>
    a lv2:Plugin ;
    lv2:binary <chordant.so> ;
    rdfs:seeAlso <chordant.ttl> .

<https://danja.github.io/flues/plugins/chordant#ui>
    a ui:X11UI ;
    ui:binary <chordant_ui.so> ;
    rdfs:label "Chordant" .
