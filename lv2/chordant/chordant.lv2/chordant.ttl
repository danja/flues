@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .

<https://danja.github.io/flues/plugins/chordant>
    a lv2:AudioPlugin , lv2:EffectPlugin ;
    doap:name "Chordant" ;
    doap:license <https://opensource.org/licenses/MIT> ;
    doap:maintainer [
        foaf:name "Danny Ayers" ;
        foaf:homepage <https://danja.github.io/flues/>
    ] ;
    lv2:project <https://danja.github.io/flues> ;
    lv2:requiredFeature urid:map ;
    lv2:optionalFeature lv2:hardRTCapable ;
    ui:ui <https://danja.github.io/flues/plugins/chordant#ui> ;
    rdfs:comment "Euclidean transport-synced capture/mix effect for rhythmic chord-like layering." ;

    lv2:port [
        a atom:AtomPort, lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "control" ;
        lv2:name "Control" ;
        atom:bufferType atom:Sequence ;
        atom:supports <http://lv2plug.in/ns/ext/time#Position> ;
        rdfs:comment "Host transport/tempo input" ;
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 1 ;
        lv2:symbol "in_l" ;
        lv2:name "Input L" ;
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 2 ;
        lv2:symbol "in_r" ;
        lv2:name "Input R" ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 3 ;
        lv2:symbol "out_l" ;
        lv2:name "Output L" ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 4 ;
        lv2:symbol "out_r" ;
        lv2:name "Output R" ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "total_bars" ;
        lv2:name "Total Bars" ;
        lv2:default 2 ;
        lv2:minimum 0.125 ;
        lv2:maximum 8 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "division" ;
        lv2:name "Division" ;
        lv2:default 8 ;
        lv2:minimum 1 ;
        lv2:maximum 16 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "steps" ;
        lv2:name "Steps" ;
        lv2:default 2 ;
        lv2:minimum 0 ;
        lv2:maximum 16 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "offset" ;
        lv2:name "Offset" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 15 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "fade" ;
        lv2:name "Fade" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "max_segments" ;
        lv2:name "Max Segments" ;
        lv2:default 8 ;
        lv2:minimum 1 ;
        lv2:maximum 12 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "nocap_passthrough" ;
        lv2:name "NoCap Pass" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "clear_trigger" ;
        lv2:name "Clear Trig" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 13 ;
        lv2:symbol "capture_mode" ;
        lv2:name "Cap Mode" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 3 ;
        lv2:portProperty lv2:integer ;
        lv2:scalePoint [ rdfs:label "1 Step" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "2 Steps" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "4 Steps" ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "1 Bar" ; rdf:value 3 ] ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 14 ;
        lv2:symbol "dry_wet" ;
        lv2:name "Dry/Wet" ;
        lv2:default 100 ;
        lv2:minimum 0 ;
        lv2:maximum 100 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 15 ;
        lv2:symbol "attack_ms" ;
        lv2:name "Attack ms" ;
        lv2:default 8 ;
        lv2:minimum 1 ;
        lv2:maximum 200 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 16 ;
        lv2:symbol "decay_ms" ;
        lv2:name "Decay ms" ;
        lv2:default 180 ;
        lv2:minimum 10 ;
        lv2:maximum 800 ;
    ] .
