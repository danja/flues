        lv2:index 24 ;
        lv2:symbol "trigger1_action" ;
        lv2:name "Trigger 1 Action" ;
        lv2:default 2 ;
        lv2:minimum 0 ;
        lv2:maximum 10 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Reseed" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Burst" ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "Rand Source" ; rdf:value 3 ] ;
        lv2:scalePoint [ rdfs:label "Rand Delay" ; rdf:value 4 ] ;
        lv2:scalePoint [ rdfs:label "Rand All" ; rdf:value 5 ] ;
        lv2:scalePoint [ rdfs:label "Scene Down" ; rdf:value 6 ] ;
        lv2:scalePoint [ rdfs:label "Scene Up" ; rdf:value 7 ] ;
        lv2:scalePoint [ rdfs:label "Panic" ; rdf:value 8 ] ;
        lv2:scalePoint [ rdfs:label "Mode Down" ; rdf:value 9 ] ;
        lv2:scalePoint [ rdfs:label "Mode Up" ; rdf:value 10 ] ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 25 ;
        lv2:symbol "trigger1_rate" ;
        lv2:name "Trigger 1 Rate" ;
        lv2:default 0.28 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 26 ;
        lv2:symbol "trigger1_chance" ;
        lv2:name "Trigger 1 Chance" ;
        lv2:default 0.55 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 27 ;
        lv2:symbol "trigger2_action" ;
        lv2:name "Trigger 2 Action" ;
        lv2:default 4 ;
        lv2:minimum 0 ;
        lv2:maximum 10 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Reseed" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Burst" ; rdf:value 2 ] ;
