@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .

<https://danja.github.io/flues/plugins/outsider-client>
    a lv2:Plugin ;
    lv2:binary <outsider_client.so> ;
    rdfs:seeAlso <outsider-client.ttl> .

<https://danja.github.io/flues/plugins/outsider-client#ui>
    a ui:X11UI ;
    ui:binary <outsider_client_ui.so> ;
    rdfs:label "Outsider Client" .

