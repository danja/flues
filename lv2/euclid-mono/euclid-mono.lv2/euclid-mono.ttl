@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .

<https://danja.github.io/flues/plugins/euclid-mono>
    a lv2:UtilityPlugin ;
    doap:name "Flues EuclidMono" ;
    doap:license <https://opensource.org/licenses/MIT> ;
    doap:maintainer [
        foaf:name "Danny Ayers" ;
        foaf:homepage <https://danja.github.io/flues/>
    ] ;
    lv2:project <https://danja.github.io/flues> ;
    lv2:requiredFeature urid:map ;
    lv2:optionalFeature lv2:hardRTCapable ;
    ui:ui <https://danja.github.io/flues/plugins/euclid-mono#ui> ;
    rdfs:comment "Two-pattern Euclidean MIDI generator with boolean logic combiner and single-note output." ;

    lv2:port [
        a atom:AtomPort, lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "control" ;
        lv2:name "Control" ;
        atom:bufferType atom:Sequence ;
        atom:supports <http://lv2plug.in/ns/ext/time#Position> ,
                     <http://lv2plug.in/ns/ext/midi#MidiEvent> ;
    ] , [
        a atom:AtomPort, lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "midi_out" ;
        lv2:name "MIDI Out" ;
        atom:bufferType atom:Sequence ;
        atom:supports <http://lv2plug.in/ns/ext/midi#MidiEvent> ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 2 ;
        lv2:symbol "steps_per_bar" ;
        lv2:name "Steps" ;
        lv2:default 16 ;
        lv2:minimum 8 ;
        lv2:maximum 24 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 3 ;
        lv2:symbol "swing" ;
        lv2:name "Swing" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "seed" ;
        lv2:name "Seed" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 65535 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "midi_note" ;
        lv2:name "MIDI Note" ;
        lv2:default 60 ;
        lv2:minimum 0 ;
        lv2:maximum 127 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "a_beats" ;
        lv2:name "Pattern A Beats" ;
        lv2:default 4 ;
        lv2:minimum 0 ;
        lv2:maximum 24 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "a_offset" ;
        lv2:name "Pattern A Offset" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 23 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "a_length" ;
        lv2:name "Pattern A Length" ;
        lv2:default 16 ;
        lv2:minimum 1 ;
        lv2:maximum 24 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "a_random" ;
        lv2:name "Pattern A Random" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "b_beats" ;
        lv2:name "Pattern B Beats" ;
        lv2:default 3 ;
        lv2:minimum 0 ;
        lv2:maximum 24 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "b_offset" ;
        lv2:name "Pattern B Offset" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 23 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "b_length" ;
        lv2:name "Pattern B Length" ;
        lv2:default 16 ;
        lv2:minimum 1 ;
        lv2:maximum 24 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 13 ;
        lv2:symbol "b_random" ;
        lv2:name "Pattern B Random" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 14 ;
        lv2:symbol "invert_a" ;
        lv2:name "Invert A" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:integer , lv2:toggled ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 15 ;
        lv2:symbol "invert_b" ;
        lv2:name "Invert B" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:integer , lv2:toggled ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 16 ;
        lv2:symbol "logic_op" ;
        lv2:name "Logic Op" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 5 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "AND" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "OR" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "XOR" ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "NAND" ; rdf:value 3 ] ;
        lv2:scalePoint [ rdfs:label "NOR" ; rdf:value 4 ] ;
        lv2:scalePoint [ rdfs:label "XNOR" ; rdf:value 5 ] ;
    ] .
