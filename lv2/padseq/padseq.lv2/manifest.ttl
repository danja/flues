@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .

<https://danja.github.io/flues/plugins/padseq>
    a lv2:Plugin ;
    lv2:binary <padseq.so> ;
    rdfs:seeAlso <padseq.ttl> .

<https://danja.github.io/flues/plugins/padseq#ui>
    a ui:X11UI ;
    ui:binary <padseq_ui.so> ;
    rdfs:label "PadSeq Control Panel" .
