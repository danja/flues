@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix time: <http://lv2plug.in/ns/ext/time#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .

<https://danja.github.io/flues/plugins/drumgen>
    a lv2:UtilityPlugin ;
    doap:name "Flues DrumGen" ;
    doap:license <https://opensource.org/licenses/MIT> ;
    doap:maintainer [
        foaf:name "Danny Ayers" ;
        foaf:homepage <https://danja.github.io/flues/>
    ] ;
    lv2:project <https://danja.github.io/flues> ;
    lv2:requiredFeature urid:map ;
    lv2:optionalFeature lv2:hardRTCapable ;
    state:state <https://danja.github.io/flues/plugins/drumgen#pattern-state> ;
    ui:ui <https://danja.github.io/flues/plugins/drumgen#ui> ;
    rdfs:comment "Transport-synced polyphonic drum MIDI generator with genre templates, Euclidean variation, and exact pattern persistence." ;

    lv2:port [
        a atom:AtomPort, lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "control" ;
        lv2:name "Control" ;
        atom:bufferType atom:Sequence ;
        atom:supports time:Position ;
        rdfs:comment "Host transport and tempo input" ;
    ] , [
        a atom:AtomPort, lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "midi_out" ;
        lv2:name "MIDI Out" ;
        atom:bufferType atom:Sequence ;
        atom:supports <http://lv2plug.in/ns/ext/midi#MidiEvent> ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 2 ;
        lv2:symbol "genre" ;
        lv2:name "Genre" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 7 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Rock" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Disco" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Shuffle" ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "Electro" ; rdf:value 3 ] ;
        lv2:scalePoint [ rdfs:label "Dub" ; rdf:value 4 ] ;
        lv2:scalePoint [ rdfs:label "Motorik" ; rdf:value 5 ] ;
        lv2:scalePoint [ rdfs:label "Bossa" ; rdf:value 6 ] ;
        lv2:scalePoint [ rdfs:label "Afro" ; rdf:value 7 ] ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 3 ;
        lv2:symbol "channel" ;
        lv2:name "Channel" ;
        lv2:default 10 ;
        lv2:minimum 1 ;
        lv2:maximum 16 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "1" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "2" ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "3" ; rdf:value 3 ] ;
        lv2:scalePoint [ rdfs:label "4" ; rdf:value 4 ] ;
        lv2:scalePoint [ rdfs:label "5" ; rdf:value 5 ] ;
        lv2:scalePoint [ rdfs:label "6" ; rdf:value 6 ] ;
        lv2:scalePoint [ rdfs:label "7" ; rdf:value 7 ] ;
        lv2:scalePoint [ rdfs:label "8" ; rdf:value 8 ] ;
        lv2:scalePoint [ rdfs:label "9" ; rdf:value 9 ] ;
        lv2:scalePoint [ rdfs:label "10" ; rdf:value 10 ] ;
        lv2:scalePoint [ rdfs:label "11" ; rdf:value 11 ] ;
        lv2:scalePoint [ rdfs:label "12" ; rdf:value 12 ] ;
        lv2:scalePoint [ rdfs:label "13" ; rdf:value 13 ] ;
        lv2:scalePoint [ rdfs:label "14" ; rdf:value 14 ] ;
        lv2:scalePoint [ rdfs:label "15" ; rdf:value 15 ] ;
        lv2:scalePoint [ rdfs:label "16" ; rdf:value 16 ] ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "kit_map" ;
        lv2:name "Kit Map" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Flues Drumkit" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "GM" ; rdf:value 1 ] ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "bars" ;
        lv2:name "Bars" ;
        lv2:default 2 ;
        lv2:minimum 1 ;
        lv2:maximum 4 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "resolution" ;
        lv2:name "Resolution" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "1/8" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "1/16" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "1/16T" ; rdf:value 2 ] ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "density" ;
        lv2:name "Density" ;
        lv2:default 0.58 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "variation" ;
        lv2:name "Variation" ;
        lv2:default 0.35 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "fill" ;
        lv2:name "Fill" ;
        lv2:default 0.30 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "seed" ;
        lv2:name "Seed" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 65535 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "kick_amt" ;
        lv2:name "Kick Amount" ;
        lv2:default 0.78 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "backbeat_amt" ;
        lv2:name "Backbeat Amount" ;
        lv2:default 0.76 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 13 ;
        lv2:symbol "hat_amt" ;
        lv2:name "Hat Amount" ;
        lv2:default 0.82 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 14 ;
        lv2:symbol "aux_amt" ;
        lv2:name "Perc Amount" ;
        lv2:default 0.28 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 15 ;
        lv2:symbol "action_new" ;
        lv2:name "New" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1048576 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 16 ;
        lv2:symbol "action_mutate" ;
        lv2:name "Mutate" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1048576 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 17 ;
        lv2:symbol "action_fill" ;
        lv2:name "Fill" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1048576 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 18 ;
        lv2:symbol "tom_amt" ;
        lv2:name "Tom Amount" ;
        lv2:default 0.30 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 19 ;
        lv2:symbol "metal_amt" ;
        lv2:name "Metal Amount" ;
        lv2:default 0.26 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] .
