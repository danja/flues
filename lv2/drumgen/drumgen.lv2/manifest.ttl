@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .

<https://danja.github.io/flues/plugins/drumgen>
    a lv2:Plugin ;
    lv2:binary <drumgen.so> ;
    rdfs:seeAlso <drumgen.ttl> .

<https://danja.github.io/flues/plugins/drumgen#ui>
    a ui:X11UI ;
    ui:binary <drumgen_ui.so> ;
    rdfs:label "Flues DrumGen" .
