@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix time: <http://lv2plug.in/ns/ext/time#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .

<https://danja.github.io/flues/plugins/euclidean-gate>
    a lv2:Plugin , lv2:EffectPlugin ;
    doap:name "Euclidean Gate" ;
    doap:description "Tempo-synced Euclidean gating with AD envelope" ;
    doap:license <https://opensource.org/licenses/MIT> ;
    doap:maintainer [
        a foaf:Person ;
        foaf:name "Danny Ayers" ;
        foaf:homepage <https://github.com/danja> ;
    ] ;
    lv2:project [
        a doap:Project ;
        doap:name "Flues Synthesizers" ;
    ] ;

    lv2:requiredFeature urid:map ;

    lv2:port [
        a lv2:InputPort , atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports time:Position ;
        lv2:index 0 ;
        lv2:symbol "control_in" ;
        lv2:name "Control In" ;
        rdfs:comment "Transport sync for tempo" ;
    ] , [
        a lv2:InputPort , lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "in_l" ;
        lv2:name "Input L" ;
    ] , [
        a lv2:InputPort , lv2:AudioPort ;
        lv2:index 2 ;
        lv2:symbol "in_r" ;
        lv2:name "Input R" ;
    ] , [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 3 ;
        lv2:symbol "out_l" ;
        lv2:name "Output L" ;
    ] , [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 4 ;
        lv2:symbol "out_r" ;
        lv2:name "Output R" ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "beats" ;
        lv2:name "Beats" ;
        lv2:default 4 ;
        lv2:minimum 0 ;
        lv2:maximum 16 ;
        lv2:portProperty lv2:integer ;
        rdfs:comment "Number of Euclidean pulses in 16 steps" ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "offset" ;
        lv2:name "Offset" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 15 ;
        lv2:portProperty lv2:integer ;
        rdfs:comment "Rotation offset for the Euclidean pattern" ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "attack" ;
        lv2:name "Attack (ms)" ;
        lv2:default 5 ;
        lv2:minimum 0.1 ;
        lv2:maximum 500.0 ;
        rdfs:comment "Envelope attack time in milliseconds" ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "decay" ;
        lv2:name "Decay (ms)" ;
        lv2:default 120 ;
        lv2:minimum 1.0 ;
        lv2:maximum 2000.0 ;
        rdfs:comment "Envelope decay time in milliseconds" ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "mode" ;
        lv2:name "Mode" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [
            rdfs:label "Gate" ;
            rdf:value 0
        ] , [
            rdfs:label "Mute" ;
            rdf:value 1
        ] ;
        rdfs:comment "Gate (pass on beats) or Mute (mute on beats)" ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "random_add" ;
        lv2:name "Random Add" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Probability to insert extra beats" ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "random_sub" ;
        lv2:name "Random Subtract" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Probability to skip beats" ;
    ] .
