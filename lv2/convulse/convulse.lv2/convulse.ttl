@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix time: <http://lv2plug.in/ns/ext/time#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .

<https://danja.github.io/flues/plugins/convulse>
    a lv2:AudioPlugin , lv2:EffectPlugin ;
    doap:name "Convulse" ;
    doap:license <https://opensource.org/licenses/MIT> ;
    doap:maintainer [
        foaf:name "Danny Ayers" ;
        foaf:homepage <https://danja.github.io/flues/>
    ] ;
    lv2:project <https://danja.github.io/flues> ;
    lv2:requiredFeature urid:map ;
    lv2:optionalFeature lv2:hardRTCapable ;
    ui:ui <https://danja.github.io/flues/plugins/convulse#ui> ;
    rdfs:comment "Experimental stereo convolver whose FIR kernel is regenerated by an internal waveform synth." ;

    lv2:port [
        a atom:AtomPort, lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "control" ;
        lv2:name "Control" ;
        atom:bufferType atom:Sequence ;
        atom:supports time:Position ;
        rdfs:comment "Optional host transport and tempo input for kernel refresh timing." ;
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 1 ;
        lv2:symbol "in_l" ;
        lv2:name "Input L" ;
        lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 2 ;
        lv2:symbol "in_r" ;
        lv2:name "Input R" ;
        lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 3 ;
        lv2:symbol "out_l" ;
        lv2:name "Output L" ;
        lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 4 ;
        lv2:symbol "out_r" ;
        lv2:name "Output R" ;
        lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "dry_wet" ;
        lv2:name "Dry/Wet" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Blend between original input and convolved output." ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "kernel_size" ;
        lv2:name "Kernel Size" ;
        lv2:default 256 ;
        lv2:minimum 32 ;
        lv2:maximum 1024 ;
        lv2:portProperty lv2:integer ;
        rdfs:comment "Number of FIR taps rendered by the internal synth." ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "mode" ;
        lv2:name "Mode" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 5 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Sine"; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Saw"; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Pulse"; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "Noise"; rdf:value 3 ] ;
        lv2:scalePoint [ rdfs:label "FM"; rdf:value 4 ] ;
        lv2:scalePoint [ rdfs:label "Chirp"; rdf:value 5 ] ;
        rdfs:comment "Waveform family used to render the convolution kernel." ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "pitch" ;
        lv2:name "Pitch" ;
        lv2:default 220 ;
        lv2:minimum 20 ;
        lv2:maximum 2000 ;
        rdfs:comment "Base frequency in Hz used by the kernel synth." ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "shape" ;
        lv2:name "Shape" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Mode-dependent harmonic or modulation shaping." ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "decay" ;
        lv2:name "Decay" ;
        lv2:default 0.6 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Controls how quickly the rendered kernel decays over time." ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "refresh" ;
        lv2:name "Refresh" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 8.0 ;
        rdfs:comment "Kernel refresh rate. When tempo is available it is refreshes per quarter note, otherwise Hz. Zero freezes the current kernel." ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "stereo_width" ;
        lv2:name "Stereo Width" ;
        lv2:default 0.3 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Phase and detune offset between left and right kernels." ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 13 ;
        lv2:symbol "feedback" ;
        lv2:name "Feedback" ;
        lv2:default 10 ;
        lv2:minimum 0 ;
        lv2:maximum 95 ;
        lv2:portProperty lv2:integer ;
        rdfs:comment "Feeds part of the wet output back into the convolver input." ;
    ] .
