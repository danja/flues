@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix ui: <http://lv2plug.in/ns/extensions/ui#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://danja.github.io/flues/plugins/drumkit>
    a lv2:InstrumentPlugin ;
    doap:name "Flues Drumkit" ;
    doap:description "Hardcore industrial TR-909 drum synthesizer with 11 voices (kick, snare, clap, dual toms, split hi-hats, crash, bash, cowbell, clave). MIDI channel 10." ;
    doap:license <https://opensource.org/licenses/MIT> ;
    doap:maintainer [
        foaf:name "Danny Ayers" ;
        foaf:homepage <https://danja.github.io/flues/>
    ] ;
    lv2:requiredFeature <http://lv2plug.in/ns/ext/urid#map> ;
    ui:ui <https://danja.github.io/flues/plugins/drumkit#ui> ;

    # Port 0: Audio Output
    lv2:port [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "audio_out" ;
        lv2:name "Audio Out"
    ] , [
        # Port 1: MIDI Input
        a lv2:InputPort , atom:AtomPort ;
        lv2:index 1 ;
        lv2:symbol "midi_in" ;
        lv2:name "MIDI In" ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        rdfs:comment "MIDI channel 10 only. Mapping: Kick 36, Clap 39, Snare 40, Crash 41, Closed HH 42, Lo Tom 45, Open HH 46, Hi Tom 50, Bash 51, Cowbell 52, Clave 53."
    ] , [
        # Port 2: Kick Pitch
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 2 ;
        lv2:symbol "kick_pitch" ;
        lv2:name "Kick Pitch" ;
        lv2:default 0.35 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Starting pitch for kick sweep (60-250 Hz exponential)"
    ] , [
        # Port 3: Kick Decay
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 3 ;
        lv2:symbol "kick_decay" ;
        lv2:name "Kick Decay" ;
        lv2:default 0.4 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Envelope decay time (50-1500ms exponential)"
    ] , [
        # Port 4: Kick Drive
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "kick_drive" ;
        lv2:name "Kick Drive" ;
        lv2:default 0.3 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Saturation amount (1.0-10.0 linear)"
    ] , [
        # Port 5: Kick Punch
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "kick_punch" ;
        lv2:name "Kick Punch" ;
        lv2:default 0.15 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "High-frequency click enhancement"
    ] , [
        # Port 6: Kick Level
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "kick_level" ;
        lv2:name "Kick Level" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.5 ;
        rdfs:comment "Per-voice output level"
    ] , [
        # Port 7: Snare Tone
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "snare_tone" ;
        lv2:name "Snare Tone" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Body/shell resonator mix and Q (4-20)"
    ] , [
        # Port 8: Snare Snap
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "snare_snap" ;
        lv2:name "Snare Snap" ;
        lv2:default 0.6 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Noise level and HPF cutoff (500Hz-4kHz)"
    ] , [
        # Port 9: Snare Level
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "snare_level" ;
        lv2:name "Snare Level" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.5 ;
        rdfs:comment "Per-voice output level"
    ] , [
        # Port 10: Clap Density
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "clap_density" ;
        lv2:name "Clap Density" ;
        lv2:default 0.55 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Impulse count (3-7) and spacing tightness"
    ] , [
        # Port 11: Clap Tone
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "clap_tone" ;
        lv2:name "Clap Tone" ;
        lv2:default 0.45 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Bandpass center frequency (800Hz-3.5kHz)"
    ] , [
        # Port 12: Clap Level
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "clap_level" ;
        lv2:name "Clap Level" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.5 ;
        rdfs:comment "Per-voice output level"
    ] , [
        # Port 13: Tom 1 Pitch
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 13 ;
        lv2:symbol "tom1_pitch" ;
        lv2:name "Tom 1 Pitch" ;
        lv2:default 0.4 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Lo tom base frequency (60-150Hz exponential)"
    ] , [
        # Port 14: Tom 1 Decay
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 14 ;
        lv2:symbol "tom1_decay" ;
        lv2:name "Tom 1 Decay" ;
        lv2:default 0.45 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Lo tom decay time (80-800ms exponential)"
    ] , [
        # Port 15: Tom 1 Level
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 15 ;
        lv2:symbol "tom1_level" ;
        lv2:name "Tom 1 Level" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.5 ;
        rdfs:comment "Per-voice output level"
    ] , [
        # Port 16: Tom 2 Pitch
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 16 ;
        lv2:symbol "tom2_pitch" ;
        lv2:name "Tom 2 Pitch" ;
        lv2:default 0.55 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Hi tom base frequency (150-400Hz exponential)"
    ] , [
        # Port 17: Tom 2 Decay
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 17 ;
        lv2:symbol "tom2_decay" ;
        lv2:name "Tom 2 Decay" ;
        lv2:default 0.45 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Hi tom decay time (80-800ms exponential)"
    ] , [
        # Port 18: Tom 2 Level
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 18 ;
        lv2:symbol "tom2_level" ;
        lv2:name "Tom 2 Level" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.5 ;
        rdfs:comment "Per-voice output level"
    ] , [
        # Port 19: Closed HH Brightness
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 19 ;
        lv2:symbol "hh_closed_brightness" ;
        lv2:name "Closed HH Brightness" ;
        lv2:default 0.6 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Closed hat HPF cutoff (4kHz-12kHz exponential)"
    ] , [
        # Port 20: Closed HH Decay
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 20 ;
        lv2:symbol "hh_closed_decay" ;
        lv2:name "Closed HH Decay" ;
        lv2:default 0.3 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Closed hat decay (50-200ms exponential)"
    ] , [
        # Port 21: Closed HH Level
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 21 ;
        lv2:symbol "hh_closed_level" ;
        lv2:name "Closed HH Level" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.5 ;
        rdfs:comment "Per-voice output level"
    ] , [
        # Port 22: Open HH Brightness
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 22 ;
        lv2:symbol "hh_open_brightness" ;
        lv2:name "Open HH Brightness" ;
        lv2:default 0.7 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Open hat HPF cutoff (4kHz-12kHz exponential)"
    ] , [
        # Port 23: Open HH Decay
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 23 ;
        lv2:symbol "hh_open_decay" ;
        lv2:name "Open HH Decay" ;
        lv2:default 0.55 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Open hat decay (200-1200ms exponential)"
    ] , [
        # Port 24: Open HH Level
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 24 ;
        lv2:symbol "hh_open_level" ;
        lv2:name "Open HH Level" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.5 ;
        rdfs:comment "Per-voice output level"
    ] , [
        # Port 25: Crash Brightness
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 25 ;
        lv2:symbol "crash_brightness" ;
        lv2:name "Crash Brightness" ;
        lv2:default 0.65 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Bandpass center frequency shift (1.5kHz-10kHz)"
    ] , [
        # Port 26: Crash Decay
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 26 ;
        lv2:symbol "crash_decay" ;
        lv2:name "Crash Decay" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Envelope decay time (300-2500ms exponential)"
    ] , [
        # Port 27: Crash Level
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 27 ;
        lv2:symbol "crash_level" ;
        lv2:name "Crash Level" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.5 ;
        rdfs:comment "Per-voice output level"
    ] , [
        # Port 28: Cowbell Tone
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 28 ;
        lv2:symbol "cowbell_tone" ;
        lv2:name "Cowbell Tone" ;
        lv2:default 0.45 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Dual oscillator pitch (380-1400Hz exponential)"
    ] , [
        # Port 29: Cowbell Decay
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 29 ;
        lv2:symbol "cowbell_decay" ;
        lv2:name "Cowbell Decay" ;
        lv2:default 0.35 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Envelope decay time (50-1000ms exponential)"
    ] , [
        # Port 30: Cowbell Level
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 30 ;
        lv2:symbol "cowbell_level" ;
        lv2:name "Cowbell Level" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.5 ;
        rdfs:comment "Per-voice output level"
    ] , [
        # Port 31: Clave Tone
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 31 ;
        lv2:symbol "clave_tone" ;
        lv2:name "Clave Tone" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Resonant click pitch (900-4200Hz exponential)"
    ] , [
        # Port 32: Clave Decay
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 32 ;
        lv2:symbol "clave_decay" ;
        lv2:name "Clave Decay" ;
        lv2:default 0.25 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Envelope decay time (20-400ms exponential)"
    ] , [
        # Port 33: Clave Level
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 33 ;
        lv2:symbol "clave_level" ;
        lv2:name "Clave Level" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.5 ;
        rdfs:comment "Per-voice output level"
    ] , [
        # Port 34: Bash Size
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 34 ;
        lv2:symbol "bash_size" ;
        lv2:name "Bash Size" ;
        lv2:default 0.45 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Base plate/pipe frequency (180-1200Hz exponential)"
    ] , [
        # Port 35: Bash Spread
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 35 ;
        lv2:symbol "bash_spread" ;
        lv2:name "Bash Spread" ;
        lv2:default 0.55 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Inharmonic overtone spread (adds clangy beating)"
    ] , [
        # Port 36: Bash Decay
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 36 ;
        lv2:symbol "bash_decay" ;
        lv2:name "Bash Decay" ;
        lv2:default 0.7 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Ring-out time (120-1600ms exponential)"
    ] , [
        # Port 37: Bash Drive
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 37 ;
        lv2:symbol "bash_drive" ;
        lv2:name "Bash Drive" ;
        lv2:default 0.65 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Per-voice saturation (1-10× tanh)"
    ] , [
        # Port 38: Bash Noise
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 38 ;
        lv2:symbol "bash_noise" ;
        lv2:name "Bash Noise" ;
        lv2:default 0.6 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Strike noise burst level (attack grit)"
    ] , [
        # Port 39: Bash Edge
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 39 ;
        lv2:symbol "bash_edge" ;
        lv2:name "Bash Edge" ;
        lv2:default 0.7 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Highpass lift / metallic bite (800-8000Hz exponential)"
    ] , [
        # Port 40: Bash Level
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 40 ;
        lv2:symbol "bash_level" ;
        lv2:name "Bash Level" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.5 ;
        rdfs:comment "Per-voice output level"
    ] , [
        # Port 41: Bit Crush
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 41 ;
        lv2:symbol "bit_crush" ;
        lv2:name "Bit Crush" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Bit depth reduction (0=off, 1=2-bit, global)"
    ] , [
        # Port 42: Master Drive
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 42 ;
        lv2:symbol "master_drive" ;
        lv2:name "Master Drive" ;
        lv2:default 0.25 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Tanh saturation on master bus (1.0-5.0 linear)"
    ] , [
        # Port 43: Master Reverb
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 43 ;
        lv2:symbol "master_reverb" ;
        lv2:name "Master Reverb" ;
        lv2:default 0.2 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Reverb level (0-60%, Schroeder, fixed size 0.6)"
    ] , [
        # Port 44: Master Gain
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 44 ;
        lv2:symbol "master_gain" ;
        lv2:name "Master Gain" ;
        lv2:default 0.7 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "Final output level (0-100%)"
    ] .

<https://danja.github.io/flues/plugins/drumkit#ui>
    a ui:X11UI ;
    ui:binary <drumkit_ui.so> ;
    rdfs:label "Drumkit Control Panel" .
