@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .

<https://danja.github.io/flues/plugins/p-mix>
    a lv2:AudioPlugin , lv2:EffectPlugin ;
    doap:name "P-Mix" ;
    doap:license <https://opensource.org/licenses/MIT> ;
    doap:maintainer [
        foaf:name "Danny Ayers" ;
        foaf:homepage <https://danja.github.io/flues/>
    ] ;
    lv2:project <https://danja.github.io/flues> ;
    lv2:requiredFeature urid:map ;
    lv2:optionalFeature lv2:hardRTCapable ;
    ui:ui <https://danja.github.io/flues/plugins/p-mix#ui> ;
    rdfs:comment "Probabilistic mixer that applies gain changes at bar boundaries." ;

    lv2:port [
        a atom:AtomPort, lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "control" ;
        lv2:name "Control" ;
        atom:bufferType atom:Sequence ;
        atom:supports <http://lv2plug.in/ns/ext/time#Position> ;
        rdfs:comment "Host transport/tempo input" ;
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 1 ;
        lv2:symbol "in_1" ;
        lv2:name "Input 1" ;
        lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 2 ;
        lv2:symbol "in_2" ;
        lv2:name "Input 2" ;
        lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 3 ;
        lv2:symbol "in_3" ;
        lv2:name "Input 3" ;
        lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "in_4" ;
        lv2:name "Input 4" ;
        lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "in_5" ;
        lv2:name "Input 5" ;
        lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "in_6" ;
        lv2:name "Input 6" ;
        lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "in_7" ;
        lv2:name "Input 7" ;
        lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "in_8" ;
        lv2:name "Input 8" ;
        lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 9 ;
        lv2:symbol "out_1" ;
        lv2:name "Output 1" ;
        lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 10 ;
        lv2:symbol "out_2" ;
        lv2:name "Output 2" ;
        lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 11 ;
        lv2:symbol "out_3" ;
        lv2:name "Output 3" ;
        lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 12 ;
        lv2:symbol "out_4" ;
        lv2:name "Output 4" ;
        lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 13 ;
        lv2:symbol "out_5" ;
        lv2:name "Output 5" ;
        lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 14 ;
        lv2:symbol "out_6" ;
        lv2:name "Output 6" ;
        lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 15 ;
        lv2:symbol "out_7" ;
        lv2:name "Output 7" ;
        lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 16 ;
        lv2:symbol "out_8" ;
        lv2:name "Output 8" ;
        lv2:portProperty lv2:connectionOptional ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 17 ;
        lv2:symbol "granularity" ;
        lv2:name "Granularity" ;
        lv2:default 4 ;
        lv2:minimum 1 ;
        lv2:maximum 32 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 18 ;
        lv2:symbol "maintain" ;
        lv2:name "Maintain" ;
        lv2:default 50 ;
        lv2:minimum 0 ;
        lv2:maximum 100 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 19 ;
        lv2:symbol "fade" ;
        lv2:name "Fade" ;
        lv2:default 25 ;
        lv2:minimum 0 ;
        lv2:maximum 100 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 20 ;
        lv2:symbol "cut" ;
        lv2:name "Cut" ;
        lv2:default 25 ;
        lv2:minimum 0 ;
        lv2:maximum 100 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 21 ;
        lv2:symbol "fade_dur_max" ;
        lv2:name "Fade Dur Max" ;
        lv2:default 1.0 ;
        lv2:minimum 0.125 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 22 ;
        lv2:symbol "bias" ;
        lv2:name "Bias" ;
        lv2:default 50 ;
        lv2:minimum 0 ;
        lv2:maximum 100 ;
        lv2:portProperty lv2:integer ;
    ] .
