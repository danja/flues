@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .

<https://danja.github.io/flues/plugins/p-mix>
    a lv2:Plugin ;
    lv2:binary <p_mix.so> ;
    rdfs:seeAlso <p-mix.ttl> .

<https://danja.github.io/flues/plugins/p-mix#ui>
    a ui:X11UI ;
    ui:binary <p_mix_ui.so> ;
    rdfs:label "P-Mix" .
