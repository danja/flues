@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .

<https://danja.github.io/flues/plugins/midi-flip>
    a lv2:Plugin ;
    lv2:binary <midi_flip.so> ;
    rdfs:seeAlso <midi-flip.ttl> .

<https://danja.github.io/flues/plugins/midi-flip#ui>
    a ui:X11UI ;
    ui:binary <midi_flip_ui.so> ;
    rdfs:label "MIDI Flip" .
