@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .

<https://danja.github.io/flues/plugins/arpiso>
    a lv2:Plugin ;
    lv2:binary <arpiso.so> ;
    rdfs:seeAlso <arpiso.ttl> .

<https://danja.github.io/flues/plugins/arpiso#ui>
    a ui:X11UI ;
    ui:binary <arpiso_ui.so> ;
    rdfs:label "ArpIso Control Panel" .
