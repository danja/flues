@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .

<https://danja.github.io/flues/plugins/quantico>
    a lv2:Plugin ;
    lv2:binary <quantico.so> ;
    rdfs:seeAlso <quantico.ttl> .

<https://danja.github.io/flues/plugins/quantico#ui>
    a ui:X11UI ;
    ui:binary <quantico_ui.so> ;
    rdfs:label "Quantico" .
