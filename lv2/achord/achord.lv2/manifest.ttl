@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui: <http://lv2plug.in/ns/extensions/ui#> .

<https://danja.github.io/flues/plugins/achord>
    a lv2:Plugin ;
    lv2:binary <achord.so> ;
    rdfs:seeAlso <achord.ttl> .

<https://danja.github.io/flues/plugins/achord#ui>
    a ui:X11UI ;
    ui:binary <achord_ui.so> ;
    rdfs:seeAlso <achord.ttl> .
