@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix time: <http://lv2plug.in/ns/ext/time#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .

<https://danja.github.io/flues/plugins/achord>
    a lv2:InstrumentPlugin , lv2:Plugin ;
    doap:name "Achord" ;
    doap:description "Launchpad Mini MK3 chord-table MIDI instrument with accordion-inspired functional harmony" ;
    doap:license <https://opensource.org/licenses/MIT> ;
    doap:maintainer [
        a foaf:Person ;
        foaf:name "Danny Ayers" ;
        foaf:homepage <https://github.com/danja> ;
    ] ;
    lv2:project [
        a doap:Project ;
        doap:name "Flues Synthesizers" ;
    ] ;
    lv2:requiredFeature urid:map ;
    lv2:optionalFeature lv2:hardRTCapable ;
    ui:ui <https://danja.github.io/flues/plugins/achord#ui> ;
    rdfs:comment "Modern Stradella-style Launchpad chord controller with transport-aware trigger modes." ;

    lv2:port [
        a lv2:InputPort , atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent , time:Position ;
        lv2:index 0 ;
        lv2:symbol "control_in" ;
        lv2:name "Control In" ;
        lv2:designation lv2:control ;
    ] , [
        a lv2:OutputPort , atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:index 1 ;
        lv2:symbol "midi_out" ;
        lv2:name "MIDI Out" ;
        lv2:designation lv2:control ;
    ] , [
        a lv2:OutputPort , atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:index 2 ;
        lv2:symbol "launchpad_out" ;
        lv2:name "Launchpad Control" ;
    ] , [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 3 ;
        lv2:symbol "audio_out_l" ;
        lv2:name "Audio Out L" ;
    ] , [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 4 ;
        lv2:symbol "audio_out_r" ;
        lv2:name "Audio Out R" ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "play_state" ;
        lv2:name "Host Play" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "current_step" ;
        lv2:name "Step 1/16" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 15 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:OutputPort , atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports atom:Chunk ;
        lv2:index 7 ;
        lv2:symbol "notify_out" ;
        lv2:name "UI Notify" ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "status_bank" ;
        lv2:name "91/92 Bank" ;
        lv2:default 0 ;
        lv2:minimum -12 ;
        lv2:maximum 12 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "status_octave" ;
        lv2:name "93/94 Octave" ;
        lv2:default 3 ;
        lv2:minimum 1 ;
        lv2:maximum 6 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "status_scale" ;
        lv2:name "95 Scale" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 6 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Major" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Nat Minor" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Dorian" ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "Mixolydian" ; rdf:value 3 ] ;
        lv2:scalePoint [ rdfs:label "Harm Minor" ; rdf:value 4 ] ;
        lv2:scalePoint [ rdfs:label "Blues" ; rdf:value 5 ] ;
        lv2:scalePoint [ rdfs:label "Chromatic" ; rdf:value 6 ] ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "status_register" ;
        lv2:name "96 Register" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 3 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "8'" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "16'+8'" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "8'+4'" ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "16'+8'+4'" ; rdf:value 3 ] ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "status_trigger" ;
        lv2:name "97 Trigger" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 4 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Direct" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Quant 1/16" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Strum Down" ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "Strum Up" ; rdf:value 3 ] ;
        lv2:scalePoint [ rdfs:label "Repeat 1/8" ; rdf:value 4 ] ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 13 ;
        lv2:symbol "status_hold" ;
        lv2:name "98 Hold" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Momentary" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Latch" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Stack" ; rdf:value 2 ] ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 14 ;
        lv2:symbol "status_bass" ;
        lv2:name "19 Bass" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 15 ;
        lv2:symbol "status_add9" ;
        lv2:name "29 Add9" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 16 ;
        lv2:symbol "status_sus" ;
        lv2:name "39 Sus" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Sus2" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Sus4" ; rdf:value 2 ] ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 17 ;
        lv2:symbol "status_inversion" ;
        lv2:name "49 Inv" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Root" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "1st" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "2nd" ; rdf:value 2 ] ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 18 ;
        lv2:symbol "status_spread" ;
        lv2:name "59 Spread" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Close" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Open" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Drop-2" ; rdf:value 2 ] ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 19 ;
        lv2:symbol "status_accent" ;
        lv2:name "69 Accent" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 20 ;
        lv2:symbol "status_voice_lead" ;
        lv2:name "79 Lead" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 21 ;
        lv2:symbol "status_clock_source" ;
        lv2:name "Clock Source" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Host" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Internal" ; rdf:value 2 ] ;
    ] , [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 22 ;
        lv2:symbol "status_active_chords" ;
        lv2:name "Active Chords" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 4 ;
        lv2:portProperty lv2:integer ;
    ] .

<https://danja.github.io/flues/plugins/achord#ui>
    a ui:X11UI ;
    ui:binary <achord_ui.so> ;
    rdfs:label "Achord Control Panel" ;
    ui:portNotification [
        ui:plugin <https://danja.github.io/flues/plugins/achord> ;
        ui:port [ lv2:index 0 ; lv2:symbol "control_in" ] ;
        ui:portIndex 0 ;
        ui:protocol ui:atomProtocol
    ] , [
        ui:plugin <https://danja.github.io/flues/plugins/achord> ;
        ui:port [ lv2:index 5 ; lv2:symbol "play_state" ] ;
        ui:portIndex 5 ;
        ui:protocol ui:floatProtocol
    ] , [
        ui:plugin <https://danja.github.io/flues/plugins/achord> ;
        ui:port [ lv2:index 2 ; lv2:symbol "launchpad_out" ] ;
        ui:portIndex 2 ;
        ui:protocol ui:atomProtocol
    ] , [
        ui:plugin <https://danja.github.io/flues/plugins/achord> ;
        ui:port [ lv2:index 6 ; lv2:symbol "current_step" ] ;
        ui:portIndex 6 ;
        ui:protocol ui:floatProtocol
    ] , [
        ui:plugin <https://danja.github.io/flues/plugins/achord> ;
        ui:port [ lv2:index 7 ; lv2:symbol "notify_out" ] ;
        ui:portIndex 7 ;
        ui:protocol ui:atomProtocol
    ] .
