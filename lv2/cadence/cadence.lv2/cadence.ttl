@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix time: <http://lv2plug.in/ns/ext/time#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .

<https://danja.github.io/flues/plugins/cadence>
    a lv2:Plugin , lv2:UtilityPlugin ;
    doap:name "Cadence" ;
    doap:license <https://opensource.org/licenses/MIT> ;
    doap:maintainer [
        foaf:name "Danny Ayers" ;
        foaf:homepage <https://danja.github.io/flues/>
    ] ;
    lv2:project <https://danja.github.io/flues> ;
    lv2:requiredFeature urid:map ;
    lv2:optionalFeature lv2:hardRTCapable ;
    state:state <https://danja.github.io/flues/plugins/cadence#progression-state> ;
    ui:ui <https://danja.github.io/flues/plugins/cadence#ui> ;
    rdfs:comment "Transport-synced MIDI harmonizer that learns one cycle of a monophonic line, infers fitting chords per segment, and emits a voiced progression on subsequent cycles." ;

    lv2:port [
        a atom:AtomPort, lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "control" ;
        lv2:name "Control" ;
        atom:bufferType atom:Sequence ;
        atom:supports time:Position ;
        rdfs:comment "Host transport and tempo input" ;
    ] , [
        a atom:AtomPort, lv2:InputPort ;
        lv2:index 1 ;
        lv2:symbol "midi_in" ;
        lv2:name "MIDI In" ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
    ] , [
        a atom:AtomPort, lv2:OutputPort ;
        lv2:index 2 ;
        lv2:symbol "midi_out" ;
        lv2:name "MIDI Out" ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 3 ;
        lv2:symbol "key" ;
        lv2:name "Key" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 11 ;
        lv2:portProperty lv2:integer ;
        lv2:scalePoint [ rdfs:label "C" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "C#" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "D" ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "D#" ; rdf:value 3 ] ;
        lv2:scalePoint [ rdfs:label "E" ; rdf:value 4 ] ;
        lv2:scalePoint [ rdfs:label "F" ; rdf:value 5 ] ;
        lv2:scalePoint [ rdfs:label "F#" ; rdf:value 6 ] ;
        lv2:scalePoint [ rdfs:label "G" ; rdf:value 7 ] ;
        lv2:scalePoint [ rdfs:label "G#" ; rdf:value 8 ] ;
        lv2:scalePoint [ rdfs:label "A" ; rdf:value 9 ] ;
        lv2:scalePoint [ rdfs:label "A#" ; rdf:value 10 ] ;
        lv2:scalePoint [ rdfs:label "B" ; rdf:value 11 ] ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "scale" ;
        lv2:name "Scale" ;
        lv2:default 2 ;
        lv2:minimum 0 ;
        lv2:maximum 11 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Chromatic" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Major" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Natural Minor" ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "Harmonic Minor" ; rdf:value 3 ] ;
        lv2:scalePoint [ rdfs:label "Pentatonic Major" ; rdf:value 4 ] ;
        lv2:scalePoint [ rdfs:label "Pentatonic Minor" ; rdf:value 5 ] ;
        lv2:scalePoint [ rdfs:label "Blues" ; rdf:value 6 ] ;
        lv2:scalePoint [ rdfs:label "Dorian" ; rdf:value 7 ] ;
        lv2:scalePoint [ rdfs:label "Mixolydian" ; rdf:value 8 ] ;
        lv2:scalePoint [ rdfs:label "Phrygian" ; rdf:value 9 ] ;
        lv2:scalePoint [ rdfs:label "Locrian" ; rdf:value 10 ] ;
        lv2:scalePoint [ rdfs:label "Phrygian Dominant" ; rdf:value 11 ] ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "cycle_bars" ;
        lv2:name "Cycle Bars" ;
        lv2:default 2 ;
        lv2:minimum 1 ;
        lv2:maximum 8 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "granularity" ;
        lv2:name "Granularity" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Beat" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Half Bar" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Bar" ; rdf:value 2 ] ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "complexity" ;
        lv2:name "Complexity" ;
        lv2:default 0.45 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "movement" ;
        lv2:name "Movement" ;
        lv2:default 0.65 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "chord_size" ;
        lv2:name "Chord Size" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Triads" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Sevenths" ; rdf:value 1 ] ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "note_length" ;
        lv2:name "Note Length" ;
        lv2:default 1.0 ;
        lv2:minimum 0.10 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "register" ;
        lv2:name "Register" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Low" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Mid" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "High" ; rdf:value 2 ] ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "spread" ;
        lv2:name "Spread" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Close" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Open" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Drop-2" ; rdf:value 2 ] ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 13 ;
        lv2:symbol "pass_input" ;
        lv2:name "Pass Input" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:integer , lv2:toggled ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 14 ;
        lv2:symbol "output_channel" ;
        lv2:name "Output Channel" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 16 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Input" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "1" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "2" ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "3" ; rdf:value 3 ] ;
        lv2:scalePoint [ rdfs:label "4" ; rdf:value 4 ] ;
        lv2:scalePoint [ rdfs:label "5" ; rdf:value 5 ] ;
        lv2:scalePoint [ rdfs:label "6" ; rdf:value 6 ] ;
        lv2:scalePoint [ rdfs:label "7" ; rdf:value 7 ] ;
        lv2:scalePoint [ rdfs:label "8" ; rdf:value 8 ] ;
        lv2:scalePoint [ rdfs:label "9" ; rdf:value 9 ] ;
        lv2:scalePoint [ rdfs:label "10" ; rdf:value 10 ] ;
        lv2:scalePoint [ rdfs:label "11" ; rdf:value 11 ] ;
        lv2:scalePoint [ rdfs:label "12" ; rdf:value 12 ] ;
        lv2:scalePoint [ rdfs:label "13" ; rdf:value 13 ] ;
        lv2:scalePoint [ rdfs:label "14" ; rdf:value 14 ] ;
        lv2:scalePoint [ rdfs:label "15" ; rdf:value 15 ] ;
        lv2:scalePoint [ rdfs:label "16" ; rdf:value 16 ] ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 15 ;
        lv2:symbol "action_learn" ;
        lv2:name "Learn" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1048576 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:OutputPort, lv2:ControlPort ;
        lv2:index 16 ;
        lv2:symbol "status_ready" ;
        lv2:name "Ready" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
    ] .
