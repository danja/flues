@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .

<https://danja.github.io/flues/plugins/slimmer>
    a lv2:Plugin ;
    lv2:binary <slimmer.so> ;
    rdfs:seeAlso <slimmer.ttl> .

<https://danja.github.io/flues/plugins/slimmer#ui>
    a ui:X11UI ;
    ui:binary <slimmer_ui.so> ;
    rdfs:label "Slimmer" .
