@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui:   <http://lv2plug.in/ns/extensions/ui#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .

<https://danja.github.io/flues/plugins/memone>
    a lv2:AudioPlugin , lv2:EffectPlugin ;
    doap:name "Memone" ;
    doap:license <https://opensource.org/licenses/MIT> ;
    doap:maintainer [
        foaf:name "Danny Ayers" ;
        foaf:homepage <https://danja.github.io/flues/>
    ] ;
    lv2:project <https://danja.github.io/flues> ;
    lv2:requiredFeature urid:map ;
    lv2:optionalFeature lv2:hardRTCapable ;
    ui:ui <https://danja.github.io/flues/plugins/memone#ui> ;
    rdfs:comment "Online LSTM time-series predictor with tempo-synced warmup and fully wet output." ;

    lv2:port [
        a atom:AtomPort, lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "control" ;
        lv2:name "Control" ;
        atom:bufferType atom:Sequence ;
        atom:supports <http://lv2plug.in/ns/ext/time#Position> ;
        rdfs:comment "Host transport/tempo input" ;
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 1 ;
        lv2:symbol "in_l" ;
        lv2:name "Input L" ;
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 2 ;
        lv2:symbol "in_r" ;
        lv2:name "Input R" ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 3 ;
        lv2:symbol "out_l" ;
        lv2:name "Output L" ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 4 ;
        lv2:symbol "out_r" ;
        lv2:name "Output R" ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "bpm" ;
        lv2:name "Manual BPM" ;
        lv2:default 120.0 ;
        lv2:minimum 40.0 ;
        lv2:maximum 240.0 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "beats_warmup" ;
        lv2:name "Warmup Beats" ;
        lv2:default 4 ;
        lv2:minimum 0 ;
        lv2:maximum 16 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "predict_gain" ;
        lv2:name "Predict Gain" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 2.0 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "predict_horizon" ;
        lv2:name "Predict Horizon" ;
        lv2:default 64 ;
        lv2:minimum 1 ;
        lv2:maximum 256 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "learning_rate" ;
        lv2:name "Learning Rate" ;
        lv2:default 0.0005 ;
        lv2:minimum 0.0 ;
        lv2:maximum 0.01 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "bptt_length" ;
        lv2:name "BPTT Length" ;
        lv2:default 32 ;
        lv2:minimum 1 ;
        lv2:maximum 64 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "grad_clip" ;
        lv2:name "Grad Clip" ;
        lv2:default 5.0 ;
        lv2:minimum 0.1 ;
        lv2:maximum 20.0 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "hidden_size" ;
        lv2:name "Hidden Size" ;
        lv2:default 8 ;
        lv2:minimum 1 ;
        lv2:maximum 16 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 13 ;
        lv2:symbol "reset" ;
        lv2:name "Reset" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 14 ;
        lv2:symbol "lr_clamp" ;
        lv2:name "LR Clamp" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 15 ;
        lv2:symbol "lr_min" ;
        lv2:name "LR Min" ;
        lv2:default 0.0001 ;
        lv2:minimum 0.0 ;
        lv2:maximum 0.01 ;
    ] , [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 16 ;
        lv2:symbol "lr_max" ;
        lv2:name "LR Max" ;
        lv2:default 0.005 ;
        lv2:minimum 0.0 ;
        lv2:maximum 0.05 ;
    ] , [
        a lv2:OutputPort, lv2:ControlPort ;
        lv2:index 17 ;
        lv2:symbol "status" ;
        lv2:name "Status" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        rdfs:comment "0=Warmup, 1=Predict" ;
    ] .
